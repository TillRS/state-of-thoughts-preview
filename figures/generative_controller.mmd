flowchart TB
    subgraph Input[" "]
        State["State s_t<br/>(input + reasoning)"]
        Tools["Tools/Actions<br/>{continue, finish, ...}"]
    end

    subgraph Controller["Generative Controller"]
        Sig["Controller Signature"]
        LLM["LLM Generate"]
        Parse["Parse Action"]
    end

    subgraph Output[" "]
        Action["Action"]
        Args["Arguments"]
        Exec["Execute Tool"]
        Intervention["Interventions<br/>(continue_reasoning, internal_reasoning, prefix)"]
    end

    State --> Sig
    Tools --> Sig
    Sig --> LLM
    LLM --> Parse
    Parse --> Action
    Parse --> Args
    Action --> Exec
    Args --> Exec
    Exec --> Intervention

